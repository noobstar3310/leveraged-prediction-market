# Copy to .env.local and fill in. .env* is gitignored.

# ---------------------------------------------------------------------------
# Market data — predict.fun (BNB Chain)
# ---------------------------------------------------------------------------

# Base URLs. Both default correctly; override only to point at a proxy.
PREDICT_BASE_URL=
PREDICT_TESTNET_BASE_URL=

# Mainnet API key, sent as `x-api-key`.
#
# REQUIRED for the "Main" data toggle in the navbar. Every mainnet route —
# /markets, /categories, /tags, everything — returns 401 without it. Testnet
# reads are completely open and need no key.
#
# NOT NEXT_PUBLIC_: market data is fetched in Server Components, so this key
# never reaches the browser. Keep it that way.
PREDICT_API_KEY=

# Optional. Testnet needs no key; set this only if that ever changes.
PREDICT_TESTNET_API_KEY=

# Set to 1 to fall back to the fabricated catalogue instead of the live API.
# Useful when the testnet API is down or when working offline.
NEXT_PUBLIC_USE_MOCK_DATA=

# ---------------------------------------------------------------------------
# Wallet — BNB Smart Chain
# ---------------------------------------------------------------------------

# 97 (BNB Testnet, default) or 56 (BNB Mainnet).
#
# The network badge in the navbar is derived from the chain the WALLET reports,
# falling back to this — so pointing it at mainnet makes the UI say "BNB
# Mainnet" in red rather than silently claiming testnet.
NEXT_PUBLIC_CHAIN_ID=

# ---------------------------------------------------------------------------
# Privy — wallet infrastructure
# ---------------------------------------------------------------------------

# Privy App ID, from https://dashboard.privy.io
#
# REQUIRED to connect a wallet. Without it the app still runs — markets, charts
# and the portfolio are read-only and work signed out — but the navbar shows
# "Wallet not configured" instead of a connect button.
#
# NEXT_PUBLIC_ on purpose: unlike PREDICT_API_KEY, this is meant to be in the
# browser. It identifies the app to Privy and authorises nothing by itself.
NEXT_PUBLIC_PRIVY_APP_ID=

# Optional. Only needed if you run several clients off one Privy app.
NEXT_PUBLIC_PRIVY_CLIENT_ID=

# ---------------------------------------------------------------------------
# Smart wallets / gas sponsorship
# ---------------------------------------------------------------------------
#
# There is NO env var for this — bundler and paymaster URLs are configured in
# the Privy dashboard, per chain, not in code.
#
# Privy's native sponsorship covers BNB mainnet (56) but NOT testnet (97), so
# testnet uses ERC-4337 smart wallets with your own infrastructure:
#
#   1. Privy dashboard -> Smart wallets -> enable, pick an implementation
#   2. Add chain 97 with bundler URL, paymaster URL and RPC URL
#      (Pimlico supports 97 as "binance-testnet")
#
# Without a paymaster the app still works — the smart account just pays its own
# gas instead of it being sponsored.
